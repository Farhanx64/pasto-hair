# --- Payload / DB ---
PAYLOAD_SECRET=replace-with-a-long-random-string
# libSQL/SQLite connection. Local file DB inside the private .data dir.
DATABASE_URI=file:./.data/pasto.db
# Private, persistent data dir (DB + media). On cPanel set to an ABSOLUTE path OUTSIDE public_html.
DATA_DIR=./.data
MEDIA_DIR=./.data/media

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar (direct API; fill before enabling booking) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=

# --- Seed (only needed when running scripts/seed.ts) ---
# Owner's Google Calendar address for the seeded staff row. Not hardcoded —
# this repo is public. Re-seeding without it skips the staff row.
SEED_STAFF_CALENDAR_ID=

# --- Email (Resend) ---
# Sender. MUST be on a domain verified in Resend (you cannot verify gmail.com).
# Keep the quotes: the value contains spaces and angle brackets, and while that
# is valid dotenv, `source .env` from bash treats it as a syntax error ( `<` is
# a redirect ) and silently stops loading everything below this line.
EMAIL_FROM="Pasto Hair <noreply@pasto.hair>"
# Where "new booking" alerts land. Any mailbox — it is only ever a recipient,
# so a personal gmail is fine. Leave blank and alerts go to EMAIL_FROM, which
# is a no-reply nobody reads.
OWNER_EMAIL=
RESEND_API_KEY=
